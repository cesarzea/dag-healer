# Where the fake upstream API is listening.
SHOP_API_URL=http://127.0.0.1:8099

# Path to the Claude Code binary, if it is not simply `claude` on PATH.
# The host demo uses your normal Claude Code sign-in and needs no key.
# CLAUDE_BIN=/usr/local/bin/claude

# Token for Claude Code inside the Airflow container (docker compose). Create
# it with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
