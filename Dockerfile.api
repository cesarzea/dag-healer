FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY fake_shop_api ./fake_shop_api
ENV FAKE_SHOP_STATE=/app/state/api_state.json
RUN mkdir -p /app/state

EXPOSE 8099
CMD ["uvicorn", "fake_shop_api.main:app", "--host", "0.0.0.0", "--port", "8099"]
